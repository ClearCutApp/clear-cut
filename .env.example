CLEARCUT_MODE=mock
## Required only by the scheduled durable analysis dispatcher.
CLEARCUT_ANALYSIS_JOB=clearcut-analysis-worker
CLOUD_RUN_REGION=us-central1
GOOGLE_CLOUD_PROJECT=
DOCAI_PROCESSOR_ID=
PARALLEL_API_KEY=
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
GRAFANA_URL=
GRAFANA_TOKEN=
GEMINI_MODEL=
GEMINI_MODEL_LITE=
# Optional validated model/budget overrides; exact values freeze with queued analyses.
CLEARCUT_PROVIDER_OPTIONS={}
VERTEX_SEARCH_DATA_STORE_ID=
NOTIFY_WEBHOOK_URL=
SCRIPTS_INTAKE_BUCKET=
CLEARCUT_LIVE_SCRIPT_GCS_URI=

# Public Firebase web app configuration, included in the Vite build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public runtime config served at /api/client-config; no rebuild is required.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
